---
title: notes — alma studio
activePage: notes
permalink: /notes/
extraCss: |
  .notes-page { min-height: 100vh; padding: 8rem 2rem 4rem; position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
  .notes-wrap { max-width: 680px; width: 100%; }
  .notes-header { text-align: center; margin-bottom: 4rem; }
  .section-eyebrow { font-size: 0.62rem; letter-spacing: 0.3em; color: var(--white-dim); margin-bottom: 1rem; }
  .section-title { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 400; margin-bottom: 1rem; letter-spacing: 0.05em; }
  .section-subtitle { font-size: 0.82rem; color: var(--white-dim); letter-spacing: 0.06em; }
  .post-list { display: flex; flex-direction: column; }
  .post-item { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; padding: 1.6rem 0; border-bottom: 1px solid var(--border); text-decoration: none; color: var(--white); transition: all 0.2s; }
  .post-item:first-child { border-top: 1px solid var(--border); }
  .post-item:hover { padding-left: 0.5rem; }
  .post-item-left { flex: 1; }
  .post-item-title { font-size: 0.95rem; font-weight: 700; letter-spacing: 0.06em; margin-bottom: 0.4rem; }
  .post-item-excerpt { font-size: 0.75rem; line-height: 1.7; color: var(--white-dim); letter-spacing: 0.03em; }
  .post-item-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; flex-shrink: 0; }
  .post-item-date { font-size: 0.62rem; letter-spacing: 0.15em; color: var(--white-muted); white-space: nowrap; }
  .post-item-author { font-size: 0.6rem; letter-spacing: 0.12em; color: var(--white-muted); }
  .post-arrow { font-size: 0.7rem; color: var(--white-muted); transition: transform 0.2s, color 0.2s; }
  .post-item:hover .post-arrow { transform: translateX(4px); color: var(--white); }
  .notes-empty { text-align: center; padding: 4rem 0; }
  .notes-empty p { font-size: 0.78rem; letter-spacing: 0.1em; color: var(--white-muted); }
  @media (max-width: 700px) { .post-item { flex-direction: column; gap: 0.5rem; } .post-item-meta { flex-direction: row; } }
---
{% extends "_includes/base.njk" %}
{% block content %}
<div class="notes-page">
  <div class="notes-wrap">
    <div class="notes-header">
      <p class="section-eyebrow">from the studio</p>
      <h1 class="section-title">notes.</h1>
      <p class="section-subtitle">thoughts, progress, and things we're figuring out.</p>
    </div>
    {% set posts = collections.notes | reverse %}
    {% if posts.length %}
    <div class="post-list">
      {% for post in posts %}
      <a class="post-item" href="{{ post.url }}">
        <div class="post-item-left">
          <p class="post-item-title">{{ post.data.title }}</p>
          <p class="post-item-excerpt">{{ post.data.excerpt }}</p>
        </div>
        <div class="post-item-meta">
          <span class="post-item-date">{{ post.data.date | postDate }}</span>
          <span class="post-item-author">{{ post.data.author }}</span>
          <span class="post-arrow">→</span>
        </div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <div class="notes-empty"><p>no notes yet. check back soon.</p></div>
    {% endif %}
  </div>
</div>
{% endblock %}
