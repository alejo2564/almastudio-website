---
title: alma studio — apps with soul
activePage: home
extraCss: |
  section { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 8rem 2rem 4rem; position: relative; z-index: 1; }
  section + section { border-top: 1px solid var(--border); }
  #home .eyebrow { font-size: 0.62rem; letter-spacing: 0.3em; color: var(--white-dim); margin-bottom: 2.5rem; animation: fadeUp 1s 0.2s ease both; }
  #home .headline { font-size: clamp(3rem, 9vw, 6.5rem); font-weight: 400; line-height: 1.05; color: var(--white); margin-bottom: 0.3em; text-align: center; animation: fadeUp 1s 0.35s ease both; }
  #home .headline em { font-style: normal; font-size: 0.65em; color: var(--white-dim); display: block; letter-spacing: 0.08em; }
  #home .subheadline { font-size: clamp(0.8rem, 2vw, 1rem); color: var(--white-dim); margin-bottom: 3.5rem; letter-spacing: 0.1em; animation: fadeUp 1s 0.5s ease both; }
  .divider { width: 30px; height: 1px; background: var(--white); margin: 0 auto 3.5rem; opacity: 0.15; animation: scaleIn 1s 0.65s ease both; }
  #home .body-text { font-size: 0.82rem; line-height: 2; color: var(--white-dim); max-width: 380px; text-align: center; letter-spacing: 0.04em; margin-bottom: 4rem; animation: fadeUp 1s 0.75s ease both; }
  .notify-form { display: flex; max-width: 360px; width: 100%; border: 1px solid var(--border); animation: fadeUp 1s 0.9s ease both; transition: border-color 0.3s ease; }
  .notify-form:focus-within { border-color: var(--border-hover); }
  .notify-form input { flex: 1; background: transparent; border: none; padding: 0.85rem 1.2rem; font-family: 'Courier Prime', monospace; font-size: 0.78rem; letter-spacing: 0.05em; color: var(--white); outline: none; }
  .notify-form input::placeholder { color: var(--white-muted); }
  .notify-form button { background: var(--white); border: none; padding: 0.85rem 1.4rem; font-family: 'Courier Prime', monospace; font-size: 0.68rem; letter-spacing: 0.15em; color: #0A0A0A; cursor: pointer; transition: opacity 0.2s; white-space: nowrap; }
  .notify-form button:hover { opacity: 0.85; }
  .notify-label { font-size: 0.62rem; letter-spacing: 0.1em; color: var(--white-muted); margin-top: 1rem; animation: fadeUp 1s 1s ease both; }
  .success-msg { display: none; font-size: 0.78rem; letter-spacing: 0.08em; color: var(--white-dim); margin-top: 1rem; }
  .scroll-hint { position: absolute; bottom: 2.5rem; font-size: 0.6rem; letter-spacing: 0.25em; color: var(--white-muted); animation: fadeUp 1s 1.3s ease both; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .scroll-hint::after { content: ''; width: 1px; height: 30px; background: var(--white-muted); display: block; animation: scrollLine 2s 1.5s ease infinite; }
  #apps, #about, #contact, #privacy { min-height: auto; padding: 8rem 2rem; }
  .section-eyebrow { font-size: 0.62rem; letter-spacing: 0.3em; color: var(--white-dim); margin-bottom: 1rem; text-align: center; }
  .section-title { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 400; text-align: center; margin-bottom: 1rem; letter-spacing: 0.05em; }
  .section-subtitle { font-size: 0.82rem; color: var(--white-dim); text-align: center; margin-bottom: 4rem; letter-spacing: 0.06em; }
  .apps-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; max-width: 900px; width: 100%; }
  .app-card { border: 1px solid var(--border); padding: 2rem; transition: border-color 0.3s ease; position: relative; overflow: hidden; }
  .app-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(240,238,233,0.3), transparent); transform: scaleX(0); transition: transform 0.4s ease; }
  .app-card:hover { border-color: var(--border-hover); }
  .app-card:hover::before { transform: scaleX(1); }
  .app-icon { width: 52px; height: 52px; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; font-size: 1.4rem; }
  .app-name { font-size: 1rem; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 0.5rem; }
  .app-tag { font-size: 0.6rem; letter-spacing: 0.2em; color: var(--white-dim); border: 1px solid var(--border); padding: 0.2rem 0.6rem; display: inline-block; margin-bottom: 1.2rem; }
  .app-desc { font-size: 0.78rem; line-height: 1.8; color: var(--white-dim); letter-spacing: 0.03em; margin-bottom: 1.8rem; }
  .app-store-btn { display: inline-flex; align-items: center; gap: 0.5rem; border: 1px solid var(--border); padding: 0.55rem 1.1rem; font-family: 'Courier Prime', monospace; font-size: 0.65rem; letter-spacing: 0.18em; color: var(--white-dim); text-decoration: none; transition: all 0.2s; }
  .app-store-btn:hover { border-color: var(--border-hover); color: var(--white); }
  .app-store-btn.coming-soon { opacity: 0.4; cursor: default; pointer-events: none; }
  .coming-card { border: 1px dashed var(--white-muted); padding: 2rem; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; min-height: 200px; gap: 0.8rem; }
  .coming-card p { font-size: 0.7rem; letter-spacing: 0.2em; color: var(--white-muted); }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; max-width: 860px; width: 100%; margin-top: 1rem; }
  .about-mission { grid-column: 1 / -1; max-width: 620px; margin: 0 auto 3rem; text-align: center; }
  .about-mission p { font-size: 0.88rem; line-height: 2; color: var(--white-dim); letter-spacing: 0.04em; }
  .founder-card { border: 1px solid var(--border); padding: 2rem; transition: border-color 0.3s; }
  .founder-card:hover { border-color: var(--border-hover); }
  .founder-initials { width: 44px; height: 44px; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; letter-spacing: 0.1em; color: var(--white-dim); margin-bottom: 1.2rem; }
  .founder-name { font-size: 0.9rem; font-weight: 700; letter-spacing: 0.12em; margin-bottom: 0.3rem; }
  .founder-role { font-size: 0.65rem; letter-spacing: 0.2em; color: var(--white-dim); margin-bottom: 1.2rem; }
  .founder-bio { font-size: 0.76rem; line-height: 1.85; color: var(--white-dim); letter-spacing: 0.03em; }
  .contact-wrap { max-width: 480px; width: 100%; text-align: center; }
  .contact-wrap .body-text { font-size: 0.82rem; line-height: 2; color: var(--white-dim); letter-spacing: 0.04em; margin-bottom: 3rem; }
  .contact-links { display: flex; flex-direction: column; border: 1px solid var(--border); }
  .contact-row { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 1.5rem; border-bottom: 1px solid var(--border); transition: background 0.2s; text-decoration: none; color: var(--white); }
  .contact-row:last-child { border-bottom: none; }
  .contact-row:hover { background: rgba(240,238,233,0.03); }
  .contact-row-label { font-size: 0.68rem; letter-spacing: 0.2em; color: var(--white-dim); }
  .contact-row-value { font-size: 0.72rem; letter-spacing: 0.08em; }
  .privacy-wrap { max-width: 560px; width: 100%; text-align: center; }
  .privacy-box { border: 1px dashed var(--white-muted); padding: 3rem 2rem; margin-top: 2rem; }
  .privacy-box p { font-size: 0.8rem; line-height: 2; color: var(--white-dim); letter-spacing: 0.04em; }
  .privacy-box .eta { font-size: 0.65rem; letter-spacing: 0.2em; color: var(--white-muted); margin-top: 1.5rem; }
  #notes-preview { min-height: auto; padding: 8rem 2rem; }
  .notes-preview-wrap { max-width: 720px; width: 100%; }
  .notes-preview-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 3rem; }
  .notes-preview-header h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 400; letter-spacing: 0.05em; }
  .notes-preview-all { font-size: 0.65rem; letter-spacing: 0.2em; color: var(--white-dim); text-decoration: none; transition: color 0.2s; }
  .notes-preview-all:hover { color: var(--white); }
  .notes-preview-list { display: flex; flex-direction: column; }
  .notes-preview-item { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; padding: 1.4rem 0; border-bottom: 1px solid var(--border); text-decoration: none; color: var(--white); transition: padding-left 0.2s; }
  .notes-preview-item:first-child { border-top: 1px solid var(--border); }
  .notes-preview-item:hover { padding-left: 0.5rem; }
  .notes-preview-title { font-size: 0.88rem; font-weight: 700; letter-spacing: 0.06em; margin-bottom: 0.3rem; }
  .notes-preview-excerpt { font-size: 0.73rem; line-height: 1.7; color: var(--white-dim); letter-spacing: 0.03em; }
  .notes-preview-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; flex-shrink: 0; }
  .notes-preview-date { font-size: 0.6rem; letter-spacing: 0.15em; color: var(--white-muted); white-space: nowrap; }
  .notes-preview-arrow { font-size: 0.7rem; color: var(--white-muted); transition: transform 0.2s, color 0.2s; }
  .notes-preview-item:hover .notes-preview-arrow { transform: translateX(4px); color: var(--white); }
  .notes-empty-preview { font-size: 0.75rem; letter-spacing: 0.1em; color: var(--white-muted); padding: 2rem 0; text-align: center; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  @media (max-width: 700px) { section { padding: 6rem 1.5rem 3rem; } #apps, #about, #contact, #privacy, #notes-preview { padding: 5rem 1.5rem; } .about-grid { grid-template-columns: 1fr; gap: 1.5rem; } .about-mission { grid-column: 1; } .notify-form { flex-direction: column; } .notify-form button { padding: 0.85rem; } .notes-preview-item { flex-direction: column; gap: 0.4rem; } .notes-preview-meta { flex-direction: row; } }
---
{% extends "_includes/base.njk" %}
{% block content %}
<section id="home">
  <p class="eyebrow">coming soon</p>
  <h1 class="headline">apps with<em>soul.</em></h1>
  <p class="subheadline">crafted with intention.</p>
  <div class="divider"></div>
  <p class="body-text">we're a small studio building ios apps that are simple, beautiful, and genuinely useful. our first app is on its way.</p>
  <form class="notify-form" onsubmit="handleSubmit(event)">
    <input type="email" placeholder="your@email.com" required>
    <button type="submit">notify me</button>
  </form>
  <p class="notify-label">be first to know when we launch.</p>
  <p class="success-msg" id="success">you're on the list. thank you.</p>
  <div class="scroll-hint">scroll</div>
</section>
<section id="apps">
  <p class="section-eyebrow reveal">our work</p>
  <h2 class="section-title reveal">the apps.</h2>
  <p class="section-subtitle reveal">thoughtful tools for everyday moments.</p>
  <div class="apps-grid">
    <div class="app-card reveal">
      <div class="app-icon">♟</div>
      <p class="app-name">sudoku battle.</p>
      <span class="app-tag">puzzle · multiplayer · ios</span>
      <p class="app-desc">challenge your friends to real-time sudoku. same grid, same clock — first to finish wins. finally, a reason to take sudoku personally.</p>
      <a class="app-store-btn coming-soon" href="#">coming to app store</a>
    </div>
    <div class="coming-card reveal"><p>more apps in the works.</p><p>stay tuned.</p></div>
  </div>
</section>
<section id="about">
  <p class="section-eyebrow reveal">who we are</p>
  <h2 class="section-title reveal">the studio.</h2>
  <div class="about-mission reveal">
    <p>alma studio is a two-person ios app studio built on a simple belief: software should feel as good as it works. we obsess over the details — the transitions, the typography, the moments between taps — because we think the best apps are the ones you barely notice you're using.</p>
  </div>
  <div class="about-grid">
    <div class="founder-card reveal">
      <div class="founder-initials">al</div>
      <p class="founder-name">alejandro linares.</p>
      <p class="founder-role">co-founder</p>
      <p class="founder-bio">by day, an investment banker in new york. by night, a builder. alejandro started alma studio out of a conviction that the tools and taste developed in finance could be channeled into making software that actually matters to people.</p>
    </div>
    <div class="founder-card reveal">
      <div class="founder-initials">mc</div>
      <p class="founder-name">maria cabrera.</p>
      <p class="founder-role">co-founder</p>
      <p class="founder-bio">also a new york-based banker, maria co-founded alma studio to build products rooted in real interests rather than market trends. she brings sharp judgment and a belief that the best apps are born from genuine curiosity, not spreadsheets.</p>
    </div>
  </div>
</section>
<section id="contact">
  <div class="contact-wrap">
    <p class="section-eyebrow reveal">get in touch</p>
    <h2 class="section-title reveal">say hello.</h2>
    <p class="body-text reveal">we'd love to hear from you — whether you have a question, a collaboration idea, or just want to say hi.</p>
    <div class="contact-links reveal">
      <a class="contact-row" href="mailto:hello@almastudio.io"><span class="contact-row-label">email</span><span class="contact-row-value">hello@almastudio.io</span></a>
      <a class="contact-row" href="https://almastudio.io"><span class="contact-row-label">web</span><span class="contact-row-value">almastudio.io</span></a>
      <div class="contact-row"><span class="contact-row-label">location</span><span class="contact-row-value">new york, ny</span></div>
    </div>
  </div>
</section>
<section id="privacy">
  <div class="privacy-wrap">
    <p class="section-eyebrow reveal">legal</p>
    <h2 class="section-title reveal">privacy policy.</h2>
    <div class="privacy-box reveal">
      <p>our privacy policy is being prepared and will be published here before our first app launches on the app store.</p>
      <p class="eta">— coming soon —</p>
    </div>
  </div>
</section>
<section id="notes-preview">
  <div class="notes-preview-wrap">
    <div class="notes-preview-header reveal">
      <h2>notes.</h2>
      <a href="/notes/" class="notes-preview-all">all notes →</a>
    </div>
    {% set recentPosts = collections.notes | reverse %}
    {% if recentPosts.length %}
    <div class="notes-preview-list">
      {% for post in recentPosts | limit(3) %}
      <a class="notes-preview-item reveal" href="{{ post.url }}">
        <div>
          <p class="notes-preview-title">{{ post.data.title }}</p>
          <p class="notes-preview-excerpt">{{ post.data.excerpt }}</p>
        </div>
        <div class="notes-preview-meta">
          <span class="notes-preview-date">{{ post.data.date | postDate }}</span>
          <span class="notes-preview-arrow">→</span>
        </div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <p class="notes-empty-preview">no notes yet. check back soon.</p>
    {% endif %}
  </div>
</section>
<script>
function handleSubmit(e) {
  e.preventDefault();
  const form = e.target;
  form.style.opacity = '0'; form.style.transition = 'opacity 0.4s';
  setTimeout(() => { form.style.display = 'none'; document.querySelector('.notify-label').style.display = 'none'; document.getElementById('success').style.display = 'block'; }, 400);
}
const sections = document.querySelectorAll('section');
window.addEventListener('scroll', () => {
  let current = '';
  sections.forEach(s => { if (window.scrollY >= s.offsetTop - 200) current = s.getAttribute('id'); });
  document.querySelectorAll('.nav-links a').forEach(a => { a.classList.remove('active'); if (a.getAttribute('href') === '#' + current || (current && a.getAttribute('href') === '/#' + current)) a.classList.add('active'); });
});
</script>
{% endblock %}
